{
  "name": "@otalan/capacitor",
  "type": "module",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Otalan OTA client SDK for Capacitor apps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cirtadev/otalan-sdk.git",
    "directory": "capacitor"
  },
  "bugs": {
    "url": "https://github.com/Cirtadev/otalan-sdk/issues"
  },
  "homepage": "https://github.com/Cirtadev/otalan-sdk/tree/master/capacitor#readme",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "keywords": [
    "capacitor",
    "ota",
    "live-update",
    "mobile",
    "otalan"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --format esm --target browser --no-bundle && bun tsc -p ./tsconfig.build.json --emitDeclarationOnly",
    "prepack": "bun run build",
    "check": "bun tsc -p ./tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "bun test tests"
  },
  "peerDependencies": {
    "@capawesome/capacitor-live-update": ">=8.2.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": ">=8.3.0"
  }
}
