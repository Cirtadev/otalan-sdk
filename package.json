{
  "name": "otalan-sdk",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "expo",
    "capacitor"
  ],
  "scripts": {
    "build:capacitor": "cd capacitor && bun run build",
    "build:expo": "cd expo && bun run build",
    "build": "bun run --parallel build:capacitor build:expo",
    "check": "cd capacitor && bun run check && cd ../expo && bun run check",
    "lint": "cd capacitor && bun run lint && cd ../expo && bun run lint",
    "test": "bun test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.1",
    "jiti": "^2.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}