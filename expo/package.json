{
  "name": "@otalan/expo",
  "type": "module",
  "version": "1.1.4",
  "license": "Apache-2.0",
  "description": "Otalan OTA confirmation helper for Expo apps using expo-updates.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cirtadev/otalan-sdk.git",
    "directory": "expo"
  },
  "bugs": {
    "url": "https://github.com/Cirtadev/otalan-sdk/issues"
  },
  "homepage": "https://otalan.com",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE",
    "third-party-licenses.txt"
  ],
  "keywords": [
    "expo",
    "expo-updates",
    "ota",
    "mobile",
    "otalan"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --format esm --target browser --external @react-native-async-storage/async-storage --external expo-updates --external react-native && bun tsc -p ./tsconfig.build.json --emitDeclarationOnly",
    "prepack": "bun run build",
    "check": "bun tsc -p ./tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "bun test tests"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0"
  },
  "peerDependencies": {
    "expo-updates": "*",
    "react-native": "*"
  }
}
